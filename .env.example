# Application settings (see app/core/config.py Settings).
#
# Copy this file to .env (`cp .env.example .env`) and edit as needed.
# .env is git-ignored and must never be committed. Used both by
# `uv run uvicorn ...`/`make dev` directly and by `docker compose up`
# (compose.yaml's `env_file` reads this same .env).
MEDICAL_RAG_APP_NAME="Medical Guideline RAG"
MEDICAL_RAG_APP_VERSION=0.1.0
MEDICAL_RAG_ENVIRONMENT=local
MEDICAL_RAG_DEBUG=false
MEDICAL_RAG_LOG_LEVEL=INFO
MEDICAL_RAG_API_V1_PREFIX=/api/v1
MEDICAL_RAG_CHUNK_SIZE=1000
MEDICAL_RAG_CHUNK_OVERLAP=200

# PDF extraction backend: "pymupdf" (default; better Japanese text-layer
# extraction quality and retrieval accuracy in a local single-document
# comparison) or "pypdf" (kept for rollback/compatibility). See
# docs/adr/0017-pdf-extraction-comparison-tooling.md and
# docs/adr/0018-adopt-pymupdf-for-production-pdf-extraction.md. Note:
# PyMuPDF is AGPL-3.0/commercial dual-licensed - resolve licensing
# before any commercial or public deployment.
MEDICAL_RAG_PDF_EXTRACTOR=pymupdf

# Embedding provider: "fake" (default, deterministic, no dependencies) or
# "sentence_transformers" (local multilingual model, downloaded on first
# use). See docs/adr/0011-real-embedding-and-llm-adapters.md.
MEDICAL_RAG_EMBEDDING_PROVIDER=fake
MEDICAL_RAG_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# LLM provider: "fake" (default, no dependencies, no network access) or
# "openai". MEDICAL_RAG_LLM_API_KEY is required when the provider is
# "openai"; never commit a real key here. See
# docs/adr/0011-real-embedding-and-llm-adapters.md. For a guided,
# real-Embedding + real-LLM verification of the full RAG flow, see the
# "Live end-to-end verification" section in README.md and
# docs/adr/0012-live-e2e-verification.md.
MEDICAL_RAG_LLM_PROVIDER=fake
MEDICAL_RAG_LLM_MODEL_NAME=gpt-4o-mini
MEDICAL_RAG_LLM_API_KEY=
MEDICAL_RAG_LLM_TIMEOUT_SECONDS=30

# The following will be added in later issues as each integration is
# implemented (kept here only as a forward-looking placeholder list).
# MEDICAL_RAG_DATABASE_URL=
# MEDICAL_RAG_QDRANT_URL=
