# Application settings (see app/core/config.py Settings).
#
# Copy this file to .env (`cp .env.example .env`) and edit as needed.
# .env is git-ignored and must never be committed. Used both by
# `uv run uvicorn ...`/`make dev` directly and by `docker compose up`
# (compose.yaml's `env_file` reads this same .env).
MEDICAL_RAG_APP_NAME="Medical Guideline RAG"
MEDICAL_RAG_APP_VERSION=0.1.0
MEDICAL_RAG_ENVIRONMENT=local
MEDICAL_RAG_DEBUG=false
MEDICAL_RAG_LOG_LEVEL=INFO
MEDICAL_RAG_API_V1_PREFIX=/api/v1
MEDICAL_RAG_CHUNK_SIZE=1000
MEDICAL_RAG_CHUNK_OVERLAP=200

# PDF extraction backend: "pymupdf" (default; better Japanese text-layer
# extraction quality and retrieval accuracy in a local single-document
# comparison) or "pypdf" (kept for rollback/compatibility). See
# docs/adr/0017-pdf-extraction-comparison-tooling.md and
# docs/adr/0018-adopt-pymupdf-for-production-pdf-extraction.md. Note:
# PyMuPDF is AGPL-3.0/commercial dual-licensed - resolve licensing
# before any commercial or public deployment.
MEDICAL_RAG_PDF_EXTRACTOR=pymupdf

# Embedding provider: "fake" (default, deterministic, no dependencies) or
# "sentence_transformers" (local multilingual model, downloaded on first
# use). See docs/adr/0011-real-embedding-and-llm-adapters.md.
MEDICAL_RAG_EMBEDDING_PROVIDER=fake
MEDICAL_RAG_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# LLM provider: "fake" (default, no dependencies, no network access) or
# "openai". MEDICAL_RAG_LLM_API_KEY is required when the provider is
# "openai"; never commit a real key here. See
# docs/adr/0011-real-embedding-and-llm-adapters.md. For a guided,
# real-Embedding + real-LLM verification of the full RAG flow, see the
# "Live end-to-end verification" section in README.md and
# docs/adr/0012-live-e2e-verification.md.
MEDICAL_RAG_LLM_PROVIDER=fake
MEDICAL_RAG_LLM_MODEL_NAME=gpt-4o-mini
MEDICAL_RAG_LLM_API_KEY=
MEDICAL_RAG_LLM_TIMEOUT_SECONDS=30
# Max total characters of retrieved-passage text included in the prompt
# sent to the Llm. See
# docs/adr/0022-context-length-control-and-llm-error-handling.md.
MEDICAL_RAG_LLM_CONTEXT_MAX_CHARS=6000

# Base URL of the running FastAPI server that the Streamlit demo UI
# (app/ui/streamlit_app.py, `make ui`) sends questions to. Only needs
# changing if the API runs on a different host/port than the default
# `make dev`. See docs/adr/0024-streamlit-demo-ui.md. When running the
# full stack via `docker compose up` instead, compose.yaml's `ui`
# service overrides this to http://app:8000 (the "app" service's
# Compose network name) automatically - no edit needed here for that
# case.
MEDICAL_RAG_UI_API_BASE_URL=http://127.0.0.1:8000

# Vector store backend: "memory" (default, process-only, cleared on
# restart - what tests use) or "qdrant" (persists to
# MEDICAL_RAG_VECTOR_STORE_PATH via Qdrant's embedded/local mode - no
# separate Qdrant server process required). See
# docs/adr/0026-persistent-vector-store.md. This default stays "memory"
# for tests/CI; compose.yaml's `app` service overrides it to "qdrant"
# so `docker compose up` always persists to the qdrant_storage volume -
# see the "Docker" section in README.md.
MEDICAL_RAG_VECTOR_STORE_PROVIDER=memory
# Local directory Qdrant's embedded client stores data in. Only used
# when MEDICAL_RAG_VECTOR_STORE_PROVIDER=qdrant. Never commit its
# contents - already covered by qdrant_storage/ in .gitignore.
MEDICAL_RAG_VECTOR_STORE_PATH=./qdrant_storage
MEDICAL_RAG_VECTOR_STORE_COLLECTION_NAME=guideline_chunks

# External object storage for guideline PDFs: "local" (default - PDFs
# are never persisted beyond the request's own temp file; only
# POST /documents/index works) or "s3" (required for
# POST /documents/upload and POST /documents/index-from-s3). See
# docs/adr/0028-s3-document-storage.md.
MEDICAL_RAG_STORAGE_PROVIDER=local
# S3 bucket name. Only used when MEDICAL_RAG_STORAGE_PROVIDER=s3.
# Credentials and region are resolved via boto3's own standard chain
# (e.g. an ECS task role in AWS) - never set here.
MEDICAL_RAG_S3_BUCKET_NAME=

# The following will be added in later issues as each integration is
# implemented (kept here only as a forward-looking placeholder list).
# MEDICAL_RAG_DATABASE_URL=
