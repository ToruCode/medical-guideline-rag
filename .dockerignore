# -----------------------------
# Version control / CI
# -----------------------------
.git/
.github/

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# -----------------------------
# Virtual Environment
# -----------------------------
.venv/
venv/

# -----------------------------
# Environment Variables
# -----------------------------
# Only .env.example is meant to be readable inside the image build
# context; a real .env (with secrets) must never be baked into a layer.
.env
.env.*
!.env.example

# -----------------------------
# IDE / OS
# -----------------------------
.vscode/
.DS_Store
Thumbs.db

# -----------------------------
# Project data and docs (not needed inside the image)
# -----------------------------
data/
docs/
tests/
scripts/
logs/
*.log

# -----------------------------
# Local infra volumes (if ever created alongside the repo)
# -----------------------------
qdrant_storage/
postgres_data/
