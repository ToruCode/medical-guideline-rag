<mxfile host="app.diagrams.net" version="24.7.0">
  <diagram id="aws-architecture" name="AWS構成図">
    <mxGraphModel dx="1600" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Medical Guideline RAG &amp;mdash; AWS構成図" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- External actors (outside AWS Cloud) -->
        <mxCell id="internet" value="Internet&#10;利用者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#666666;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="github" value="GitHub Actions&#10;CI/CD&#10;（OIDC連携）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#24292F;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="terraform" value="Terraform&#10;構築者（IaC）&#10;apply / destroy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EBFF;strokeColor=#5C4EE5;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#5C4EE5;" vertex="1" parent="1">
          <mxGeometry x="30" y="700" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- AWS Cloud boundary -->
        <mxCell id="awscloud" value="AWS Cloud (ap-northeast-1)" style="fillColor=none;strokeColor=#232F3E;dashed=1;verticalAlign=top;fontColor=#232F3E;whiteSpace=wrap;html=1;strokeWidth=2.5;align=left;spacingLeft=20;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="1310" height="790" as="geometry" />
        </mxCell>

        <!-- VPC boundary -->
        <mxCell id="vpc" value="VPC（Public Subnet ×2、NAT Gatewayなし）" style="fillColor=#FBF7FF;strokeColor=#8C4FFF;dashed=1;verticalAlign=top;fontColor=#8C4FFF;whiteSpace=wrap;html=1;strokeWidth=2;align=left;spacingLeft=20;fontSize=13;fontStyle=1;" vertex="1" parent="1">
