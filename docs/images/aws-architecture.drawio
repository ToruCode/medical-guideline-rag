        </mxCell>

        <!-- ECS ui -->
        <mxCell id="ecsui" value="ECS Fargate: ui&#10;Streamlit : 8501&#10;CPU256 / Mem512" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
