          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="NFS:2049（appのみ）" style="endArrow=block;html=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="ecsapp" target="efs">
          <mxGeometry relative="1" as="geometry" />
