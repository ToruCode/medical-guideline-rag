        <!-- IAM note -->
        <mxCell id="iamnote" value="IAM: ECSタスク実行ロール（ECR pull / CloudWatch Logs書込 / Secrets Manager読取）／appタスクロール（S3・EFSのみ）／uiタスクロール（追加権限なし）&#10;&amp;mdash; それぞれ必要最小限の権限のみを付与（最小権限の原則）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#D9A404;fontColor=#6B5300;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="1160" height="60" as="geometry" />
        </mxCell>

        <!-- Runtime arrows (solid, dark) -->
        <mxCell id="e1" value="HTTP : 80" style="endArrow=block;html=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="internet" target="alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="/api/*, /docs 等" style="endArrow=block;html=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="alb" target="ecsapp">
