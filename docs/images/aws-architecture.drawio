        <mxCell id="e6" value="S3 API（appのみ）" style="endArrow=block;html=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="ecsapp" target="s3">
          <mxGeometry relative="1" as="geometry" />
