        <!-- Terraform -> AWS Cloud boundary (build-time only) -->
        <mxCell id="e13" value="terraform apply / destroy&#10;（AWS Cloud内の全46リソースを一括管理）" style="endArrow=block;html=1;strokeColor=#5C4EE5;strokeWidth=2.2;dashed=1;fontColor=#5C4EE5;fontSize=11;exitX=1;exitY=0.3;" edge="1" parent="1" source="terraform" target="awscloud">
