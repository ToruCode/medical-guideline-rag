        <mxCell id="e9" value="Logs（実行ロール）" style="endArrow=block;html=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="ecsui" target="cloudwatch">
          <mxGeometry relative="1" as="geometry" />
