        <!-- Deploy-time arrows (dashed, gray) -->
        <mxCell id="e10" value="OIDC認証 → ECRへpush（mainブランチpushのみ）" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=1.6;dashed=1;fontColor=#555555;fontSize=11;exitX=1;exitY=0.4;" edge="1" parent="1" source="github" target="ecr">
          <mxGeometry relative="1" as="geometry" />
