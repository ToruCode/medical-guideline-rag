        <mxCell id="e7" value="起動時に解決（実行ロール）" style="endArrow=block;html=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="ecsapp" target="secrets">
