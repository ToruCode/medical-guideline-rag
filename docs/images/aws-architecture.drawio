        <mxCell id="e3" value="それ以外（既定）" style="endArrow=block;html=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="alb" target="ecsui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="HTTP（ALB経由でappを呼び出し）" style="endArrow=block;html=1;strokeColor=#232F3E;strokeWidth=2;dashed=1;fontColor=#232F3E;fontSize=11;curved=1;" edge="1" parent="1" source="ecsui" target="alb">
          <mxGeometry relative="1" as="geometry">
